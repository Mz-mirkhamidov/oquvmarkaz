# .env.example — .env.local is NEVER committed to git

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
SUPABASE_JWT_SECRET=                # used to sign JWTs

# Storage (11.7 — swappable layer)
STORAGE_PROVIDER=supabase           # supabase | s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=  # same value as TELEGRAM_BOT_USERNAME — client needs it for the t.me/ deep link
TELEGRAM_WEBHOOK_SECRET=

# Better Auth (TZ v2 §13) — see docs/DEPLOY_CHECKLIST.md
BETTER_AUTH_SECRET=                 # >= 32 chars
BETTER_AUTH_URL=                    # the deployed origin, e.g. https://qalqon.uz
AUTH_DATABASE_URL=                  # qalqon_auth role (supabase/migrations/0012_app_role.sql)
DATABASE_URL=                       # qalqon_app role (same migration)
SELFTEST_KEY=                       # >= 16 chars, gates /api/auth/selftest

# App
NEXT_PUBLIC_APP_URL=https://qalqon.uz
APP_TIMEZONE=Asia/Tashkent
CRON_SECRET=

# Monitoring (optional — unset means no-op, not a build failure)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=                         # only needed for source map upload at build time
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
